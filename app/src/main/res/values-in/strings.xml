    <string name="sunnah_kahf_friday">Surah Al-Kahfi di hari Jumat</string>
    <string name="sunnah_kahf_friday_note">“Siapa yang membaca surah Al-Kahfi pada hari Jumat, akan diterangi cahaya di antara dua Jumat.” (HR. Al-Hakim dan Al-Baihaqi; dishahihkan Al-Albani)</string>
    <string name="sunnah_mulk_sajdah">As-Sajdah dan Al-Mulk sebelum tidur</string>
    <string name="sunnah_mulk_sajdah_note">Nabi ﷺ tidak tidur sampai membaca Alif Lam Mim Tanzil (As-Sajdah) dan Tabarak (Al-Mulk). (HR. At-Tirmidzi; dishahihkan Al-Albani)</string>
    <string name="sunnah_kursi">Ayat Kursi sebelum tidur</string>
    <string name="sunnah_kursi_note">Siapa yang membacanya ketika hendak tidur, ia senantiasa dijaga oleh Allah dan setan tidak mendekatinya sampai pagi. (HR. Al-Bukhari)</string>
    <string name="sunnah_baqarah_end">Dua ayat terakhir Al-Baqarah di malam hari</string>
    <string name="sunnah_baqarah_end_note">“Siapa yang membaca dua ayat terakhir surah Al-Baqarah pada malam hari, keduanya telah mencukupinya.” (HR. Al-Bukhari dan Muslim)</string>
    <string name="sunnah_three_quls">Al-Ikhlas, Al-Falaq, An-Nas sebelum tidur</string>
    <string name="sunnah_three_quls_note">Setiap malam Nabi ﷺ menyatukan kedua telapak tangan, meniupnya, membaca tiga surah ini, lalu mengusapkan ke tubuh, tiga kali. (HR. Al-Bukhari)</string>
    <string name="sunnah_kahf_ten">Sepuluh ayat pertama Al-Kahfi</string>
    <string name="sunnah_kahf_ten_note">“Siapa yang menghafal sepuluh ayat pertama surah Al-Kahfi, ia dilindungi dari Dajjal.” (HR. Muslim)</string>
