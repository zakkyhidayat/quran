    <string name="onb_welcome_title">Assalamu’alaykum</string>
    <string name="onb_welcome_body">Selamat datang. Aplikasi ini untuk membaca Al-Qur’an dengan mushaf Madinah. Pertama, pilih bahasa aplikasi.</string>
    <string name="onb_download_title">Unduh data Al-Qur’an dan font halaman</string>
    <string name="onb_download_body">Database dan seluruh 604 font halaman harus selesai diunduh sebelum Anda dapat membaca. Semuanya disimpan di perangkat ini agar dapat dibaca secara luring.</string>
    <string name="onb_download_size">Ukuran unduhan: %1$s</string>
    <string name="onb_download_start">Unduh dan lanjutkan</string>
    <string name="onb_downloading">Mengunduh %1$s dari %2$s</string>
    <string name="onb_download_error">Data Al-Qur’an atau font halaman gagal diunduh atau diverifikasi. Periksa koneksi dan ruang penyimpanan, lalu coba lagi.</string>
    <string name="onb_download_full_features">Edisi penuh juga memuat informasi topik dan surah.</string>
    <string name="quran_data_title">Data Al-Qur’an</string>
    <string name="quran_data_sub">Unduh atau pulihkan berkas Al-Qur’an luring</string>
    <string name="quran_data_maintenance_body">Periksa rilis GitHub terlebih dahulu. Unduh database Al-Qur’an dan seluruh 604 font halaman hanya jika data lokal berbeda atau tidak valid. Data lokal yang valid tetap dapat digunakan luring. Berkas tersimpan di penyimpanan privat aplikasi dan tidak masuk cadangan perangkat.</string>
    <string name="quran_data_confirm_title">Unduh data Al-Qur’an terbaru?</string>
    <string name="quran_data_confirm_body">Database dan font halaman lokal akan diganti setelah berkas baru terverifikasi. Ukuran unduhan sekitar %1$s. Biarkan aplikasi tetap terbuka hingga selesai.</string>
    <string name="quran_data_refresh">Unduh atau perbarui data</string>
    <string name="quran_data_refresh_confirm">Unduh dan ganti</string>
    <string name="quran_data_refresh_success">Data Al-Qur’an terbaru berhasil dipasang.</string>
    <string name="quran_data_restart_required">Tutup lalu buka kembali aplikasi untuk memakai data terbaru. Jika berkas terhapus karena penyimpanan aplikasi dihapus atau aplikasi dipasang ulang, unduh kembali dari sini.</string>
    <string name="onb_mushaf_title">Tentang mushaf ini</string>
    <string name="onb_mushaf_body">Halamannya mengikuti mushaf Madinah cetakan Kompleks Raja Fahd: rasm Utsmani, riwayat Hafs, 604 halaman, 15 baris. Gaya halaman lain, seperti IndoPak atau Shamarly, tidak disertakan, jadi bila Anda terbiasa dengan salah satunya, bentuk huruf dan letak halamannya akan terlihat berbeda.</string>
    <string name="onb_translation_title">Terjemahan</string>
    <string name="onb_translation_body">Terjemahan diunduh saat Anda menambahkannya, sehingga aplikasi tetap kecil. Anda juga boleh membaca tanpa terjemahan.</string>
